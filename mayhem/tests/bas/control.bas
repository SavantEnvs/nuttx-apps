10 DIM A(10)
20 FOR I = 1 TO 10: A(I) = I * I: NEXT I
30 S = 0
40 FOR I = 1 TO 10 STEP 2
50   S = S + A(I)
60 NEXT I
70 PRINT "sum"; S
80 GOSUB 200
90 I = 0
100 WHILE I < 3
110   I = I + 1
120 WEND
130 IF I = 3 THEN PRINT "while ok" ELSE PRINT "while bad"
140 ON I - 1 GOTO 150, 160
150 PRINT "one": END
160 PRINT "two"
170 DEF FNSQ(X) = X * X
180 PRINT FNSQ(7), INT(7.9), ABS(-2), SGN(-5), 7 MOD 3, 2 ^ 10
190 END
200 PRINT "sub": RETURN
